# ==================================================
# NAXINE FRONTEND - VARIABLES DE ENTORNO
# ==================================================
# Copia este archivo a .env.local y ajusta los valores según tu entorno

# ==================================================
# CONFIGURACIÓN DE ENTORNO DE LA APLICACIÓN
# ==================================================
# NEXT_PUBLIC_APP_ENV controla el comportamiento de la aplicación
# 
# Valores posibles:
# - "production"  → Modo "Próximamente" (solo /proximamente y /registro-profesional)
#                   Usar en: naxine.com
# 
# - "staging"     → Funcionalidad completa para pruebas
#                   Usar en: prueba.naxine.com
# 
# - "development" → Funcionalidad completa para desarrollo local
#                   Usar en: localhost (valor por defecto)
#
# ⚠️ IMPORTANTE: Esta variable debe configurarse en Vercel para cada entorno

# Para desarrollo local (puedes omitir esta línea, se usa "development" por defecto)
NEXT_PUBLIC_APP_ENV=development

# ==================================================
# API CONFIGURATION
# ==================================================
# URL base de la API (debe incluir /api al final)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# URL del frontend
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001

# URL del backend (sin /api)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Timeout para las peticiones a la API (en milisegundos)
NEXT_PUBLIC_API_TIMEOUT=15000

# URL del sitio (para SEO y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ==================================================
# STRIPE CONFIGURATION
# ==================================================
# Clave pública de Stripe (usa keys de prueba en desarrollo)
# Obtén tus keys en: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# ==================================================
# SENDGRID CONFIGURATION
# ==================================================
# ⚠️ IMPORTANTE: Estas variables NO tienen NEXT_PUBLIC_ porque son
# solo para el servidor (API routes). Nunca se exponen al navegador.

# API Key de SendGrid
# Obtén tu key en: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# Email desde el cual se enviarán los correos
SENDGRID_FROM_EMAIL=noreply@tudominio.com

# Email donde se recibirán las solicitudes de registro de profesionales
# Si no se especifica, se usa SENDGRID_FROM_EMAIL
SENDGRID_TO_EMAIL=admin@tudominio.com

